; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Oasis Keeper"
config/description="A desert oasis building and water-management simulation inspired by ClanFolk, Dwarf Fortress and RimWorld."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/EventBus.gd"
GameConfig="*res://scripts/autoload/GameConfig.gd"
GameClock="*res://scripts/autoload/GameClock.gd"
WorldMap="*res://scripts/autoload/WorldMap.gd"
ClimateSystem="*res://scripts/autoload/ClimateSystem.gd"
WaterSystem="*res://scripts/autoload/WaterSystem.gd"
PlantSystem="*res://scripts/autoload/PlantSystem.gd"
BuildSystem="*res://scripts/autoload/BuildSystem.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
