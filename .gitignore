# Godot
# The engine's import/analysis cache. Regenerated on open; never commit it
# (large, machine-specific, and it churns on every run).
.godot/
.import/
export_presets.cfg
export_credentials.cfg
*.translation
# Note: *.import files beside assets ARE tracked on purpose -- Godot needs
# them to resolve imported resources on a fresh clone.

# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Logs and temp files
*.log
*.tmp
*.swp
*.swo

# Editors
.vscode/
.idea/

# Build systems
build/
dist/
target/
.gradle/
.mypy_cache/
.pytest_cache/
coverage/
htmlcov/
.coverage

# System files
.DS_Store
Thumbs.db

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
