# Godot
# The engine's import/analysis cache. Regenerated on open; must never be
# committed (it is large, machine-specific and churns constantly).
.godot/
.import/
export_presets.cfg
export.cfg
export_credentials.cfg
*.translation

# Note: *.import files next to assets ARE intentionally committed -- Godot
# needs them to resolve imported resources on a fresh clone.

# Build artifacts
build/
dist/
*.so
*.dll
*.exe
*.dylib
*.pdb
*.o
*.obj
*.a

# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Environment
.env
.env.local

# Editors
.vscode/
.idea/
*.swp
*.swo
*.tmp

# System
.DS_Store
Thumbs.db

# Logs
*.log

# Archives
*.zip
*.gz
*.tar
*.tgz
*.7z
*.rar
